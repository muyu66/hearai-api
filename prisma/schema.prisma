generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

/// 用户表
model User {
  id            BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  username      String @unique @db.VarChar(50)
  nickname      String @default("") @db.VarChar(100)
  /// 语句难度等级
  sentenceLevel Int    @default(0) @map("sentence_level") @db.UnsignedTinyInt

  wechatOpenid String? @unique @map("wechat_openid") @db.VarChar(255)
  googleOpenid String? @unique @map("google_openid") @db.VarChar(255)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(0)

  @@map("users")
}

/// 语句表
model Sentence {
  id          BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  words       String @db.VarChar(200)
  translation String @db.VarChar(400)
  md5         String @db.VarChar(32)
  level       Int    @default(0) @map("level") @db.UnsignedTinyInt
  /// 差评数量
  badScore    Int    @default(0) @map("bad_score") @db.UnsignedInt

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(0)

  userSentenceHistories UserSentenceHistory[]

  /// 同一语句只能有一条记录
  @@unique(md5)
  @@map("sentences")
}

/// AI字典
model AiDict {
  word        String @db.VarChar(200)
  translation String @db.VarChar(1000)
  ukPhonetic  String @map("uk_phonetic") @db.VarChar(255)
  usPhonetic  String @map("us_phonetic") @db.VarChar(255)
  /// 差评数量
  badScore    Int    @default(0) @map("bad_score") @db.UnsignedInt

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(0)

  @@unique(word)
  @@map("ai_dict")
}

/// 用户学习语句历史表
model UserSentenceHistory {
  id         BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  userId     BigInt @map("user_id") @db.UnsignedBigInt
  sentenceId BigInt @map("sentence_id") @db.UnsignedBigInt

  hintCount    Int     @map("hint_count") @db.UnsignedTinyInt
  thinkingTime Int     @map("thinking_time") @db.UnsignedInt
  isFinished   Boolean @map("is_finished") @db.UnsignedTinyInt
  speaker      String  @db.VarChar(20)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(0)

  sentence Sentence @relation(fields: [sentenceId], references: [id])

  @@unique([id])
  @@map("user_sentence_history")
}

/// 用户登录历史表
model UserLoginHistory {
  id         BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  userId     BigInt @map("user_id") @db.UnsignedBigInt
  deviceInfo String @map("device_info") @db.VarChar(1000)

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(0)

  @@unique([id])
  @@map("user_login_history")
}

/// 系统配置表
model System {
  key   String @db.VarChar(255)
  value String @db.VarChar(255)

  /// 同一语句只能有一条记录
  @@unique(key)
  @@map("system")
}
